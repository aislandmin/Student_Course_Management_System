{
  "version": 2,
  "builds": [
    {
      "src": "express-server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "react-client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "express-server/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
